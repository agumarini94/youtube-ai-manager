# =============================================================
# YouTube AI Manager — Variables de entorno
# Copia este archivo como .env y completa los valores reales
# NUNCA subas el archivo .env a GitHub
# =============================================================

# --- Anthropic (Claude API) ---
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- YouTube Data API v3 ---
# Obtener en: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- OAuth2 para subida de videos a YouTube ---
# Descarga el archivo client_secret.json desde Google Cloud Console
# y colócalo en la raíz del proyecto
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json

# ID de tu canal de YouTube
# Obtenerlo en: YouTube Studio > Configuración > Información del canal
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxxx

# Nombre exacto del canal donde querés subir videos (para verificar que el OAuth conectó bien)
# Debe coincidir con el nombre que aparece en YouTube Studio
YOUTUBE_TARGET_CHANNEL=ViralLocos

# --- ElevenLabs (texto a voz) ---
# Obtener en: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de voz preferida en ElevenLabs (opcional, se puede seleccionar desde la app)
# Ver voces disponibles en: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Bot de Telegram (automatización) ---
# Crear bot en Telegram con @BotFather → /newbot → copiar el token
TELEGRAM_TOKEN=7123456789:AAHdqTcvCHhvGua58tuW5up5yqLPM0T4Fuc
# Obtenés tu chat_id en: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Hora del workflow automático (hora Argentina, lun-vie)
HORA_AUTO=18
MINUTO_AUTO=0
